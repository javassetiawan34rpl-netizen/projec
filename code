  document.getElementById('fh-sub').textContent   = m.sub;

  document.getElementById('form-panel').classList.add('show');
  document.getElementById('sidebar').style.display = 'flex';

  stepDone('s1'); stepActive('s2');

  document.getElementById('tag-layanan').innerHTML =
    `<span class="tag active-tag">${m.icon} ${m.label}</span>`;

  const td = new Date().toISOString().split('T')[0];
  document.getElementById('tanggal').min = td;

  setTimeout(() => {
    document.getElementById('form-panel').scrollIntoView({ behavior:'smooth', block:'start' });
  }, 80);
}

/* ============================================================
   PILIH BAYAR
============================================================ */
function pilihBayar(metode, el) {
  document.querySelectorAll('.pay-opt').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  bayar = metode;

  document.getElementById('tf-box').classList.remove('show');
  document.getElementById('qris-wrap').classList.remove('show');
  document.getElementById('ss-alert').classList.remove('show');
  document.getElementById('upload-zone').classList.remove('show');

  stepDone('s2'); stepActive('s3');

  if (metode === 'transfer') {
    document.getElementById('tf-box').classList.add('show');
    document.getElementById('ss-alert').classList.add('show');
    document.getElementById('upload-zone').classList.add('show');
  } else if (metode === 'qris') {
    document.getElementById('qris-wrap').classList.add('show');
    document.getElementById('ss-alert').classList.add('show');
    document.getElementById('upload-zone').classList.add('show');
  }
}

/* ============================================================
   SALIN REKENING
============================================================ */
function salin(nomor, btn) {
  navigator.clipboard.writeText(nomor).then(() => {
    btn.textContent = '✓ Tersalin';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'Salin'; btn.classList.remove('copied'); }, 2200);
  }).catch(() => { btn.textContent = '✓ OK'; });
}

/* ============================================================
   FILE UPLOAD
============================================================ */
function fileSelected(input) {
  if (input.files && input.files[0]) {
    document.getElementById('upload-confirm').textContent = '✅ ' + input.files[0].name;
  }
}

/* ============================================================
   STEP BAR
============================================================ */
function stepDone(id)   { const e=document.getElementById(id); e.classList.remove('active'); e.classList.add('done'); }
function stepActive(id) { document.getElementById(id).classList.add('active'); }

/* ============================================================
   SUBMIT
============================================================ */
function submit() {
  const v = (id) => document.getElementById(id).value.trim();

  if (!layanan)           { alert('Silakan pilih layanan terlebih dahulu.'); return; }
  if (!v('nama'))         { alert('Nama lengkap wajib diisi.'); return; }
  if (!v('wa'))           { alert('Nomor WhatsApp wajib diisi.'); return; }
  if (!v('perusahaan'))   { alert('Nama perusahaan/instansi wajib diisi.'); return; }
  if (!v('jenis-tempat')) { alert('Jenis tempat wajib dipilih.'); return; }
  if (!v('kecamatan'))    { alert('Kecamatan di Surabaya wajib dipilih.'); return; }
  if (!v('kelurahan'))    { alert('Kelurahan/area wajib diisi.'); return; }
  if (!v('jalan'))        { alert('Nama jalan wajib diisi.'); return; }
  if (!v('tanggal'))      { alert('Tanggal kunjungan wajib diisi.'); return; }
  if (!v('sesi'))         { alert('Sesi waktu wajib dipilih.'); return; }
  if (!bayar)             { alert('Metode pembayaran wajib dipilih.'); return; }

  if (bayar === 'transfer' || bayar === 'qris') {
    if (!document.getElementById('file-bukti').files[0]) {
      alert('Harap upload screenshot bukti pembayaran terlebih dahulu!');
      return;
    }
  }

  const no           = 'NXT-' + Date.now().toString().slice(-6);
  const layananLabel = layananMap[layanan].icon + ' ' + layananMap[layanan].label;
  const bayarLabel   = { transfer:'Transfer Bank', qris:'QRIS', cash:'Cash / Tunai' }[bayar];
  const tgl          = new Date(v('tanggal')).toLocaleDateString('id-ID', {weekday:'long',day:'numeric',month:'long',year:'numeric'});
  const alamatFull   = `Jl. ${v('jalan')}, Kel. ${v('kelurahan')}, Kec. ${v('kecamatan')}, Surabaya`;

  document.getElementById('order-no').textContent = no;
  document.getElementById('sum-grid').innerHTML = `
    <div class="sum-cell"><div class="sum-k">Layanan</div><div class="sum-v">${layananLabel}</div></div>
    <div class="sum-cell"><div class="sum-k">Nama</div><div class="sum-v">${v('nama')}</div></div>
    <div class="sum-cell"><div class="sum-k">WhatsApp</div><div class="sum-v">${v('wa')}</div></div>
    <div class="sum-cell"><div class="sum-k">Perusahaan</div><div class="sum-v">${v('perusahaan')}</div></div>
    <div class="sum-cell"><div class="sum-k">Jenis Tempat</div><div class="sum-v">${v('jenis-tempat')}</div></div>
    <div class="sum-cell"><div class="sum-k">Pembayaran</div><div class="sum-v">${bayarLabel}</div></div>
    <div class="sum-cell" style="grid-column:1/-1"><div class="sum-k">Lokasi</div><div class="sum-v">${alamatFull}</div></div>
    <div class="sum-cell"><div class="sum-k">Tanggal</div><div class="sum-v">${tgl}</div></div>
    <div class="sum-cell"><div class="sum-k">Sesi</div><div class="sum-v">${v('sesi')}</div></div>
  `;

  stepDone('s3'); stepActive('s4');
  document.getElementById('form-panel').classList.remove('show');
  document.getElementById('sidebar').style.display = 'none';
  document.getElementById('success-page').classList.add('show');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ============================================================
   RESET
============================================================ */
function reset() {
  layanan = ''; bayar = '';
  document.getElementById('success-page').classList.remove('show');
  document.getElementById('form-panel').classList.remove('show');
  document.getElementById('sidebar').style.display = 'none';
  document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.pay-opt').forEach(b => b.classList.remove('active'));
  ['tf-box','qris-wrap','ss-alert','upload-zone'].forEach(id => document.getElementById(id).classList.remove('show'));
  ['s1','s2','s3','s4'].forEach(id => { const e=document.getElementById(id); e.classList.remove('done','active'); });
  document.getElementById('s1').classList.add('active');
  document.getElementById('tag-layanan').innerHTML = '<span class="tag">Pilih layanan di atas</span>';
  document.getElementById('upload-confirm').textContent = '';
  document.getElementById('file-bukti').value = '';
  document.getElementById('gmaps-link').value = '';
  const st = document.getElementById('gmaps-status');
  st.style.display = 'none'; st.className = 'gmaps-status';
  ['nama','wa','email','jabatan','perusahaan','kelurahan','jalan','nomor','patokan','tanggal','keterangan'].forEach(id => {
    const e = document.getElementById(id); if (e) e.value = '';
  });
  ['jenis-tempat','kecamatan','luas','sesi'].forEach(id => {
    const e = document.getElementById(id); if (e) e.value = '';
  });
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

