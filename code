}
.gmaps-input-row button:hover { background: #0f5a9e; }
.gmaps-status {
  margin-top: 0.6rem; font-size: 0.78rem;
  border-radius: var(--radius); padding: 0.5rem 0.75rem; font-weight: 500;
}
.gmaps-status.ok  { background:#e8f8ee; color:#1a6e35; border:1px solid #a3d9b8; }
.gmaps-status.err { background:#fdf0ef; color:#a82019; border:1px solid #f0b8b4; }
.gmaps-status.info{ background:#fff8e1; color:#7a5a00; border:1px solid #f0d87a; }
.gmaps-steps {
  margin-top: 0.75rem; display: flex; flex-wrap: wrap;
  gap: 4px; font-size: 0.7rem; color: #4a7aab; align-items: center;
}
.gmaps-steps span { white-space: nowrap; }
.gmaps-steps strong { color: #0a3d6b; }

@media (max-width: 560px) {
  .hero { padding: 3.5rem 1.2rem 5rem; }
  header { padding: 0 1.2rem; }
  .header-tag { display: none; }
  .main { padding: 2rem 1rem 3rem; }
}
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="logo">
    <div class="logo-dot">⚡</div>
    NexaTech
    <span class="header-tag">Surabaya</span>
  </div>
  <a class="header-wa" href="https://wa.me/6281234567890" target="_blank">
    💬 WhatsApp
  </a>
</header>

<!-- HERO -->
<div class="hero">
  <div class="hero-grid-bg"></div>
  <div class="hero-glow"></div>

  <div style="position:relative;z-index:1;">
    <div class="hero-badge">Khusus Wilayah Surabaya</div>

    <h1>Pasang WiFi, CCTV<br>& <span>Perbaiki Server</span></h1>

    <p class="hero-sub">
      Layanan teknologi profesional untuk bisnis Anda di Surabaya.<br>
