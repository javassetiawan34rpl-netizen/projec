<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexaTech Surabaya – WiFi · CCTV · Server</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --ink: #0d0d14;
  --paper: #f5f3ee;
  --cream: #ede9e0;
  --red: #d93025;
  --red-dark: #a82019;
  --red-glow: rgba(217,48,37,0.15);
  --gold: #c8922a;
  --muted: #7a7870;
  --border: rgba(13,13,20,0.12);
  --card: #ffffff;
  --radius: 4px;
  --radius-lg: 10px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--paper);
  color: var(--ink);
  min-height: 100vh;
  overflow-x: hidden;
}

/* ====== NOISE TEXTURE OVERLAY ====== */
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none; z-index: 0; opacity: 0.5;
}

/* ====== HEADER ====== */
header {
  position: sticky; top: 0; z-index: 200;
  background: var(--ink);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 2rem;
  height: 60px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.logo {
  font-family: 'Syne', sans-serif;
  font-weight: 800; font-size: 1.1rem;
  color: #fff; letter-spacing: -0.5px;
  display: flex; align-items: center; gap: 10px;
}

.logo-dot {
  width: 28px; height: 28px;
  background: var(--red);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
}

.header-tag {
  font-size: 0.72rem; color: rgba(255,255,255,0.4);
  letter-spacing: 1.5px; text-transform: uppercase;
  font-family: 'DM Sans', sans-serif; font-weight: 300;
}

.header-wa {
  background: #25d366; color: white;
  border: none; border-radius: var(--radius);
  padding: 7px 14px; font-size: 0.78rem; font-weight: 500;
  cursor: pointer; letter-spacing: 0.3px; text-decoration: none;
  display: flex; align-items: center; gap: 6px;
  font-family: 'DM Sans', sans-serif;
  transition: opacity 0.2s;
}
.header-wa:hover { opacity: 0.85; }

/* ====== HERO ====== */
.hero {
  position: relative; overflow: hidden;
  background: var(--ink);
  padding: 5rem 2rem 6rem;
  text-align: center;
}

.hero-grid-bg {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(217,48,37,0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(217,48,37,0.05) 1px, transparent 1px);
  background-size: 40px 40px;
}

.hero-glow {
  position: absolute; top: -100px; left: 50%;
  transform: translateX(-50%);
  width: 600px; height: 400px;
  background: radial-gradient(ellipse, rgba(217,48,37,0.2) 0%, transparent 70%);
  pointer-events: none;
}

.hero-badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(217,48,37,0.15);
  border: 1px solid rgba(217,48,37,0.3);
  color: #ff6b5b; border-radius: 20px;
  padding: 5px 14px; font-size: 0.72rem;
  font-weight: 500; letter-spacing: 0.5px;
  margin-bottom: 1.5rem;
  text-transform: uppercase;
}

.hero-badge::before {
  content: ''; width: 6px; height: 6px;
  border-radius: 50%; background: #ff6b5b;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}

.hero h1 {
  font-family: 'Syne', sans-serif;
  font-weight: 800;
  font-size: clamp(2rem, 6vw, 3.8rem);
  color: white;
  line-height: 1.1; letter-spacing: -1px;
  margin-bottom: 1rem;
}

.hero h1 span { color: var(--red); }

.hero-sub {
  color: rgba(255,255,255,0.5);
  font-size: clamp(0.9rem, 2vw, 1rem);
  max-width: 440px; margin: 0 auto 2.5rem;
  line-height: 1.7; font-weight: 300;
}

/* ====== LAYANAN PILLS ====== */
.layanan-pills {
  display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;
  margin-bottom: 3rem; position: relative; z-index: 1;
}

.pill {
  background: rgba(255,255,255,0.06);
  border: 1.5px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.7);
  border-radius: 40px;
  padding: 0.65rem 1.3rem;
  font-size: 0.85rem; font-weight: 500;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
  transition: all 0.22s ease;
  display: flex; align-items: center; gap: 8px;
}

.pill:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.25);
  color: white;
  transform: translateY(-2px);
}

.pill.active {
  background: var(--red);
  border-color: var(--red);
  color: white;
  box-shadow: 0 4px 20px rgba(217,48,37,0.35);
  transform: translateY(-2px);
}

/* ====== MAIN CONTENT ====== */
.main {
  position: relative; z-index: 1;
  max-width: 1000px; margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
}

/* ====== STEP BAR ====== */
.stepbar {
  display: flex; align-items: center;
  margin-bottom: 2.5rem;
  background: white;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  overflow: hidden;
}

.stepbar-item {
  flex: 1; padding: 0.9rem 1rem;
  text-align: center;
  font-size: 0.78rem;
  font-family: 'Syne', sans-serif;
  font-weight: 600;
  color: var(--muted);
  border-right: 1px solid var(--border);
  letter-spacing: 0.3px;
  transition: all 0.3s;
}

.stepbar-item:last-child { border-right: none; }

.stepbar-item.done {
  background: var(--red); color: white;
}

.stepbar-item.active {
  background: var(--ink); color: white;
}

.step-num {
  display: block;
  font-size: 1rem; font-weight: 800;
  margin-bottom: 2px;
}

/* ====== LAYOUT DESKTOP / MOBILE ====== */
.layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 768px) {
  .layout {
    grid-template-columns: 1.5fr 1fr;
    align-items: start;
  }
}

/* ====== FORM CARD ====== */
.form-panel {
  background: white;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  overflow: hidden;
  display: none;
}

.form-panel.show { display: block; }

.form-header {
  background: var(--ink); color: white;
  padding: 1.2rem 1.5rem;
  display: flex; align-items: center; gap: 10px;
}

.form-header-icon {
  width: 36px; height: 36px; border-radius: 6px;
  background: var(--red); display: flex;
  align-items: center; justify-content: center;
  font-size: 16px; flex-shrink: 0;
}

.form-header h3 {
  font-family: 'Syne', sans-serif;
  font-size: 0.95rem; font-weight: 700;
}

.form-header p {
  font-size: 0.75rem; opacity: 0.5; margin-top: 1px;
}

.form-body { padding: 1.5rem; }

/* ====== FORM FIELDS ====== */
.frow {
  display: grid; gap: 0.9rem; margin-bottom: 0.9rem;
  grid-template-columns: 1fr 1fr;
}

@media (max-width: 560px) {
  .frow { grid-template-columns: 1fr; }
}

.frow.single { grid-template-columns: 1fr; }

.fg { display: flex; flex-direction: column; gap: 5px; }

.fg label {
  font-size: 0.75rem; font-weight: 600;
  color: var(--muted); letter-spacing: 0.4px;
  text-transform: uppercase;
}

.fg label .req { color: var(--red); }

.fg input, .fg select, .fg textarea {
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 0.65rem 0.85rem;
  font-size: 0.88rem; font-weight: 400;
  font-family: 'DM Sans', sans-serif;
  color: var(--ink); background: var(--paper);
  transition: border-color 0.18s, background 0.18s;
  outline: none; width: 100%;
  -webkit-appearance: none;
}

.fg input:focus, .fg select:focus, .fg textarea:focus {
  border-color: var(--ink);
  background: white;
}

.fg textarea { resize: vertical; min-height: 70px; }

/* ====== DIVIDER ====== */
.divider {
  height: 1px; background: var(--border);
  margin: 1.2rem 0;
}

.section-label {
  font-family: 'Syne', sans-serif;
  font-size: 0.72rem; font-weight: 700;
  letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--muted); margin-bottom: 0.8rem;
}

/* ====== LOKASI GROUP ====== */
.lokasi-info {
  background: #f7f5ef;
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 0.75rem 0.9rem;
  font-size: 0.78rem; color: var(--muted);
  margin-bottom: 0.9rem;
  display: flex; align-items: center; gap: 8px;
}
.lokasi-info strong { color: var(--ink); }

/* ====== PAYMENT TOGGLE ====== */
.pay-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.6rem; margin-bottom: 1rem;
}

@media (max-width: 420px) {
  .pay-grid { grid-template-columns: 1fr; }
}

.pay-opt {
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 0.85rem 0.6rem;
  text-align: center; cursor: pointer;
  transition: all 0.2s; background: var(--paper);
}

.pay-opt:hover { border-color: var(--ink); background: white; }

.pay-opt.active {
  border-color: var(--ink);
  background: var(--ink);
}

.pay-opt.active .pay-icon,
.pay-opt.active .pay-label { color: white; }
.pay-opt.active .pay-sub { color: rgba(255,255,255,0.5); }

.pay-icon { font-size: 1.5rem; margin-bottom: 4px; }
.pay-label { font-size: 0.8rem; font-weight: 600; font-family: 'Syne', sans-serif; color: var(--ink); }
.pay-sub { font-size: 0.68rem; color: var(--muted); margin-top: 1px; }

/* ====== TRANSFER INFO ====== */
.tf-box {
  background: var(--paper);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden; margin-bottom: 1rem;
  display: none;
}
.tf-box.show { display: block; }

.tf-head {
  background: var(--ink); color: white;
  padding: 0.6rem 1rem;
  font-size: 0.72rem; font-weight: 600;
  letter-spacing: 0.5px; text-transform: uppercase;
  font-family: 'Syne', sans-serif;
}

.rek {
  display: flex; justify-content: space-between;
  align-items: center; padding: 0.8rem 1rem;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap; gap: 8px;
}
.rek:last-child { border-bottom: none; }

.rek-bank {
  font-size: 0.68rem; color: var(--muted);
  text-transform: uppercase; letter-spacing: 0.5px;
}
.rek-num {
  font-family: 'Syne', sans-serif;
  font-size: 1rem; font-weight: 700; color: var(--ink);
  letter-spacing: 1px;
}
.rek-name { font-size: 0.78rem; color: var(--muted); }

.copy-btn {
  background: var(--ink); color: white;
  border: none; border-radius: var(--radius);
  padding: 5px 12px; font-size: 0.72rem;
  font-weight: 600; cursor: pointer;
  font-family: 'Syne', sans-serif; letter-spacing: 0.3px;
  transition: background 0.2s; flex-shrink: 0;
}
.copy-btn.copied { background: #1a8a3c; }

/* ====== QRIS BOX ====== */
.qris-wrap {
  background: var(--paper);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 1rem;
  display: none;
  padding: 1.2rem;
  text-align: center;
}
.qris-wrap.show { display: block; }

.qris-label-top {
  font-size: 0.72rem; font-weight: 700;
  font-family: 'Syne', sans-serif;
  letter-spacing: 1px; text-transform: uppercase;
  color: var(--muted); margin-bottom: 0.8rem;
}

.qris-img-wrap {
  display: inline-block;
  background: white;
  border-radius: var(--radius);
  padding: 12px;
  border: 1px solid var(--border);
}

.qris-name {
  font-size: 0.8rem; color: var(--muted);
  margin-top: 0.6rem;
}
.qris-name strong { color: var(--ink); }

/* ====== SCREENSHOT NOTICE ====== */
.ss-alert {
  background: #fffbf0;
  border: 1.5px solid #e8c84a;
  border-radius: var(--radius);
  padding: 0.9rem 1rem;
  margin-bottom: 1rem;
  display: none;
  flex-direction: column; gap: 6px;
}
.ss-alert.show { display: flex; }
.ss-alert-title {
  font-size: 0.78rem; font-weight: 700;
  color: #7a5a00; font-family: 'Syne', sans-serif;
  display: flex; align-items: center; gap: 6px;
}
.ss-alert p { font-size: 0.78rem; color: #8a6800; line-height: 1.5; }

/* ====== UPLOAD ====== */
.upload-zone {
  border: 2px dashed rgba(13,13,20,0.2);
  border-radius: var(--radius);
  padding: 1.5rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
  margin-bottom: 1rem;
  display: none; background: var(--paper);
}
.upload-zone.show { display: block; }
.upload-zone:hover { border-color: var(--ink); background: white; }
.upload-zone p { font-size: 0.8rem; color: var(--muted); margin-top: 6px; line-height: 1.4; }
#file-bukti { display: none; }
.upload-confirm { font-size: 0.8rem; color: #1a8a3c; font-weight: 600; margin-top: 6px; }

/* ====== SUBMIT ====== */
.btn-submit {
  width: 100%;
  background: var(--red);
  color: white; border: none;
  padding: 1rem;
  border-radius: var(--radius);
  font-family: 'Syne', sans-serif;
  font-size: 0.95rem; font-weight: 700;
  cursor: pointer; letter-spacing: 0.5px;
  transition: all 0.22s;
  margin-top: 0.5rem;
}
.btn-submit:hover { background: var(--red-dark); transform: translateY(-1px); }
.btn-submit:active { transform: scale(0.99); }

/* ====== SIDEBAR ====== */
.sidebar { display: flex; flex-direction: column; gap: 1rem; }

.side-card {
  background: white;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  overflow: hidden;
}

.side-card-head {
  background: var(--ink); color: white;
  padding: 0.7rem 1.1rem;
  font-family: 'Syne', sans-serif;
  font-size: 0.75rem; font-weight: 700;
  letter-spacing: 1px; text-transform: uppercase;
}

.side-card-body { padding: 0.9rem 1.1rem; }

.side-row {
  display: flex; justify-content: space-between;
  align-items: flex-start; padding: 0.45rem 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.82rem; gap: 8px;
}
.side-row:last-child { border-bottom: none; }
.side-row .k { color: var(--muted); flex-shrink: 0; }
.side-row .v { font-weight: 600; text-align: right; }

/* Layanan tag */
.tag-row { display: flex; gap: 6px; flex-wrap: wrap; padding: 0.6rem 0; }
.tag {
  background: var(--paper); border: 1px solid var(--border);
  border-radius: 20px; padding: 3px 10px;
  font-size: 0.75rem; font-weight: 500; color: var(--ink);
}
.tag.active-tag { background: var(--ink); color: white; border-color: var(--ink); }

/* wilayah */
.wilayah-badge {
  display: inline-flex; align-items: center; gap: 4px;
  background: var(--red-glow); border: 1px solid rgba(217,48,37,0.2);
  color: var(--red); border-radius: 4px;
  padding: 4px 10px; font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.4px; text-transform: uppercase;
  margin-bottom: 0.6rem;
  font-family: 'Syne', sans-serif;
}

/* ====== SUCCESS PAGE ====== */
.success-page {
  display: none;
  background: white;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  padding: 3rem 2rem; text-align: center;
}
.success-page.show { display: block; }

.success-icon {
  width: 72px; height: 72px; border-radius: 50%;
  background: #e8f7ed; margin: 0 auto 1.2rem;
  display: flex; align-items: center; justify-content: center;
  font-size: 2.2rem;
}

.success-page h2 {
  font-family: 'Syne', sans-serif;
  font-size: 1.5rem; font-weight: 800; color: var(--ink);
  margin-bottom: 0.4rem;
}

.success-page > p { color: var(--muted); font-size: 0.88rem; line-height: 1.6; }

.order-no {
  background: var(--paper); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 0.9rem 1.2rem;
  margin: 1.2rem 0 0.6rem;
  font-family: 'Syne', sans-serif;
  font-size: 1rem; font-weight: 700; letter-spacing: 2px;
  color: var(--red);
}

.summary-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 0; border-radius: var(--radius);
  overflow: hidden; border: 1px solid var(--border);
  margin: 1rem 0;
  text-align: left;
}

@media (max-width: 560px) {
  .summary-grid { grid-template-columns: 1fr; }
}

.sum-cell {
  padding: 0.75rem 1rem;
  border-bottom: 1px solid var(--border);
  border-right: 1px solid var(--border);
  font-size: 0.82rem;
}
.sum-cell:nth-child(even) { border-right: none; }
.sum-cell .sum-k { color: var(--muted); font-size: 0.72rem; margin-bottom: 2px; }
.sum-cell .sum-v { font-weight: 600; color: var(--ink); }

.btn-new {
  margin-top: 1.5rem;
  background: var(--ink); color: white;
  border: none; border-radius: var(--radius);
  padding: 0.75rem 2rem;
  font-family: 'Syne', sans-serif;
  font-size: 0.85rem; font-weight: 700; cursor: pointer;
  letter-spacing: 0.5px; transition: opacity 0.2s;
}
.btn-new:hover { opacity: 0.8; }

/* ====== WA FLOAT ====== */
.wa-float {
  position: fixed; bottom: 24px; right: 20px;
  background: #25d366; color: white;
  width: 50px; height: 50px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem; cursor: pointer; text-decoration: none;
  box-shadow: 0 4px 16px rgba(37,211,102,0.4);
  z-index: 999; transition: transform 0.2s;
}
.wa-float:hover { transform: scale(1.08); }

/* ====== FOOTER ====== */
footer {
  background: var(--ink); color: rgba(255,255,255,0.4);
  text-align: center; padding: 2rem 1.5rem;
  font-size: 0.78rem; line-height: 2;
  font-weight: 300;
}
footer strong { color: rgba(255,255,255,0.7); font-weight: 500; }

/* ====== REQUIRED ====== */
.req { color: var(--red); }

/* ====== GOOGLE MAPS WIDGET ====== */
.gmaps-wrap {
  background: linear-gradient(135deg, #e8f4fd 0%, #f0f7ff 100%);
  border: 1.5px solid #b3d4f0;
  border-radius: var(--radius-lg);
  padding: 1.1rem 1.2rem;
  margin-bottom: 1rem;
}
.gmaps-header {
  display: flex; align-items: flex-start; gap: 10px;
  margin-bottom: 0.9rem;
}
.gmaps-icon { font-size: 1.5rem; flex-shrink: 0; line-height: 1; }
.gmaps-title {
  font-family: 'Syne', sans-serif;
  font-size: 0.85rem; font-weight: 700; color: #0a3d6b;
  margin-bottom: 2px;
}
.gmaps-hint { font-size: 0.75rem; color: #4a7aab; line-height: 1.4; }
.gmaps-input-row { display: flex; gap: 8px; }
.gmaps-input-row input {
  flex: 1; border: 1.5px solid #9ac2e8;
  border-radius: var(--radius); padding: 0.65rem 0.85rem;
  font-size: 0.85rem; font-family: 'DM Sans', sans-serif;
  color: var(--ink); background: white;
  outline: none; transition: border-color 0.18s;
}
.gmaps-input-row input:focus { border-color: #2980b9; }
.gmaps-input-row button {
  background: #1a6eb5; color: white;
  border: none; border-radius: var(--radius);
  padding: 0 1rem; font-size: 0.8rem;
  font-family: 'Syne', sans-serif; font-weight: 700;
  cursor: pointer; white-space: nowrap;
  transition: background 0.2s; letter-spacing: 0.3px; flex-shrink: 0;
}
.gmaps-input-row button:hover { background: #0f5a9e; }
.gmaps-status {
  margin-top: 0.6rem; font-size: 0.78rem;
  border-radius: var(--radius); padding: 0.5rem 0.75rem; font-weight: 500;
}
.gmaps-status.ok { background:#e8f8ee; color:#1a6e35; border:1px solid #a3d9b8; }
.gmaps-status.err { background:#fdf0ef; color:#a82019; border:1px solid #f0b8b4; }
.gmaps-status.loading { background:#fff8e1; color:#7a5a00; border:1px solid #f0d87a; }
.gmaps-steps {
  margin-top: 0.75rem; display: flex; flex-wrap: wrap;
  gap: 4px; font-size: 0.7rem; color: #4a7aab; align-items: center;
}
.gmaps-steps span { white-space: nowrap; }
.gmaps-steps strong { color: #0a3d6b; }
.gmaps-filled-tag {
  display: inline-flex; align-items: center; gap: 4px;
