function kecFromCoords(lat, lng) {
  for (const [lMin, lMax, gMin, gMax, kec] of BBOX_KEC) {
    if (lat >= lMin && lat <= lMax && lng >= gMin && lng <= gMax) return kec;
  }
  return '';
}

function kecFromText(text) {
  const t = text.toLowerCase();
  // Sort by length desc supaya keyword lebih panjang didahulukan
  const sorted = Object.keys(JALAN_KEC).sort((a,b) => b.length - a.length);
  for (const key of sorted) {
    if (t.includes(key)) return JALAN_KEC[key];
  }
  return '';
}

function setKecamatan(kec) {
  if (!kec) return false;
  const sel = document.getElementById('kecamatan');
  for (const opt of sel.options) {
    if (opt.text.toLowerCase().includes(kec.toLowerCase()) ||
        kec.toLowerCase().includes(opt.text.toLowerCase())) {
      sel.value = opt.value;
      return true;
    }
  }
  return false;
}

function capitalizeWords(str) {
  return str.replace(/\b\w/g, c => c.toUpperCase());
}

function showStatus(type, msg) {
  const el = document.getElementById('gmaps-status');
  el.style.display = 'block';
  el.className = 'gmaps-status ' + type;
  el.textContent = msg;
}

// ── Ekstrak nama tempat dari berbagai bagian URL ──────────────────────────────
function extractPlaceName(url) {
  // /place/Nama+Tempat/ atau /place/Nama%20Tempat/
  const pm = url.match(/\/place\/([^/@?&]+)/);
  if (pm) {
    return decodeURIComponent(pm[1]).replace(/\+/g,' ').replace(/_/g,' ');
  }
  // ?q=nama+tempat
  const qm = url.match(/[?&]q=([^&]+)/);
  if (qm) {
    return decodeURIComponent(qm[1]).replace(/\+/g,' ');
  }
  return '';
}

// ── Ekstrak koordinat dari URL ────────────────────────────────────────────────
function extractCoords(url) {
  // /@lat,lng atau /ll=lat,lng
  let m = url.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
  if (m) return { lat: parseFloat(m[1]), lng: parseFloat(m[2]) };

  m = url.match(/[?&]ll=(-?\d+\.\d+),(-?\d+\.\d+)/);
  if (m) return { lat: parseFloat(m[1]), lng: parseFloat(m[2]) };

  m = url.match(/[?&]q=(-?\d+\.\d+),(-?\d+\.\d+)/);
  if (m) return { lat: parseFloat(m[1]), lng: parseFloat(m[2]) };

  // !3d-7.xxx!4d112.xxx  (format embed/share panjang)
  m = url.match(/!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)/);
  if (m) return { lat: parseFloat(m[1]), lng: parseFloat(m[2]) };

  return null;
}

// ── Cek apakah koordinat masuk wilayah Surabaya ──────────────────────────────
function isInSurabaya(lat, lng) {
  return lat >= -7.40 && lat <= -7.15 && lng >= 112.60 && lng <= 112.85;
}

// ── Ekstrak jalan dari nama tempat/URL ───────────────────────────────────────
function extractJalan(placeName) {
  // Cari pola "Jl.", "Jalan", "Jl " dalam nama
  const m = placeName.match(/(?:Jl\.?\s*|Jalan\s+)([\w\s.]+?)(?:No\.?\s*\d+|,|$)/i);
  if (m) return 'Jl. ' + capitalizeWords(m[1].trim());
  return '';
}

// ── MAIN PARSER ───────────────────────────────────────────────────────────────
function parseGmaps() {
  const raw = document.getElementById('gmaps-link').value.trim();

  if (!raw) {
    showStatus('err', '⚠️ Masukkan link Google Maps terlebih dahulu.');
    return;
  }

  showStatus('info', '🔍 Membaca informasi dari link...');

  let filled    = [];
  let coordsOk  = false;
  let surabayaOk = true;

  // 1. Coba ekstrak koordinat
  const coords = extractCoords(raw);
  if (coords) {
    const { lat, lng } = coords;

    if (!isInSurabaya(lat, lng)) {
      showStatus('err', '⚠️ Koordinat ini berada di luar Kota Surabaya. Layanan kami hanya tersedia di Surabaya.');
      return;
    }

    // Cari kecamatan dari koordinat
    const kecCoord = kecFromCoords(lat, lng);
    if (kecCoord && setKecamatan(kecCoord)) {
      filled.push('Kecamatan (' + kecCoord + ')');
    }
    coordsOk = true;
  }

  // 2. Ekstrak nama tempat / jalan dari URL
  const placeName = extractPlaceName(raw);
  if (placeName) {
    const pLower = placeName.toLowerCase();

    // Cek kata "surabaya" ada, atau koordinat sudah konfirmasi Surabaya
    const mentionsSby = pLower.includes('surabaya') || pLower.includes('sby');
    if (!coordsOk && !mentionsSby) {
      // Tidak ada konfirmasi Surabaya, tapi tetap coba isi — beri peringatan lunak
      surabayaOk = false;
    }

    // Cari kecamatan dari nama tempat (hanya jika belum terisi dari koordinat)
    if (!document.getElementById('kecamatan').value) {
      const kecText = kecFromText(placeName);
      if (kecText && setKecamatan(kecText)) {
        filled.push('Kecamatan (' + kecText + ')');
      }
    }

    // Coba isi jalan
    const jalan = extractJalan(placeName);
    if (jalan && !document.getElementById('jalan').value) {
      document.getElementById('jalan').value = jalan;
      filled.push('Nama Jalan');
    }

    // Isi patokan dengan nama tempat (tanpa bagian jalan)
    if (!document.getElementById('patokan').value) {
      // Ambil nama awal sebelum koma atau "Jl."
      const tok = placeName.split(/,|Jl\./i)[0].trim();
      if (tok.length > 2 && tok.length < 80) {
        document.getElementById('patokan').value = capitalizeWords(tok);
        filled.push('Patokan');
      }
    }
  }

  // 3. Coba ekstrak nama kota dari URL teks bebas
  if (!coordsOk && !document.getElementById('kecamatan').value) {
    const kecUrl = kecFromText(raw);
    if (kecUrl && setKecamatan(kecUrl)) {
      filled.push('Kecamatan (' + kecUrl + ')');
    }
  }

  // 4. Tampilkan hasil
  if (filled.length === 0) {
    showStatus('err',
      '⚠️ Tidak ada data yang bisa diekstrak dari link ini. ' +
      'Gunakan link Google Maps lengkap (bukan link pendek goo.gl) atau isi manual di bawah.');
    return;
  }

  if (!surabayaOk) {
    showStatus('err',
      '⚠️ Pastikan lokasi ini berada di Surabaya. ' +
      'Sebagian field terisi: ' + filled.join(', ') + '. Periksa kembali sebelum submit.');
    return;
  }

  showStatus('ok', '✅ Berhasil! Field terisi otomatis: ' + filled.join(', ') + '. Lengkapi sisa field jika ada.');
}
