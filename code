async function parseGmaps() {
  const input = document.getElementById('gmaps-link').value.trim();
  const status = document.getElementById('gmaps-status');

  if (!input) {
    showStatus('err', '⚠️ Masukkan link Google Maps terlebih dahulu.');
    return;
  }

  showStatus('loading', '⏳ Membaca informasi lokasi dari link...');

  try {
    // Coba ekstrak koordinat dari berbagai format link Google Maps
    let lat = null, lng = null, alamatRaw = '';

    // Format 1: /@lat,lng,zoom
    let m = input.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
    if (m) { lat = parseFloat(m[1]); lng = parseFloat(m[2]); }

    // Format 2: ?q=lat,lng
    if (!lat) {
      m = input.match(/[?&]q=(-?\d+\.\d+),(-?\d+\.\d+)/);
      if (m) { lat = parseFloat(m[1]); lng = parseFloat(m[2]); }
    }

    // Format 3: /place/nama-tempat/@lat,lng
    const placeMatch = input.match(/\/place\/([^/@]+)/);
    if (placeMatch) {
      alamatRaw = decodeURIComponent(placeMatch[1]).replace(/\+/g,' ');
    }

    // Format 4: ?q=nama+alamat
    const qMatch = input.match(/[?&]q=([^&]+)/);
    if (qMatch && !alamatRaw) {
      alamatRaw = decodeURIComponent(qMatch[1]).replace(/\+/g,' ');
    }

    // Coba geocode menggunakan Nominatim (gratis, no API key)
    if (lat && lng) {
      await geocodeByCoords(lat, lng);
    } else if (alamatRaw) {
      await geocodeByQuery(alamatRaw + ' Surabaya');
    } else {
      // Coba ekstrak nama dari URL pendek atau teks bebas
      await geocodeByQuery(input.replace(/https?:\/\/[^\s]+/g,'').trim() + ' Surabaya');
    }

  } catch(e) {
    showStatus('err', '❌ Gagal membaca lokasi. Coba isi manual atau gunakan link maps.google.com yang lengkap.');
  }
}

async function geocodeByCoords(lat, lng) {
  const url = `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&addressdetails=1&accept-language=id`;
  const res = await fetch(url, { headers: { 'Accept-Language': 'id' } });
  if (!res.ok) throw new Error('fetch fail');
  const data = await res.json();
  fillFromNominatim(data);
}

async function geocodeByQuery(query) {
  const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&addressdetails=1&limit=1&accept-language=id&countrycodes=id`;
  const res = await fetch(url, { headers: { 'Accept-Language': 'id' } });
  if (!res.ok) throw new Error('fetch fail');
  const data = await res.json();
  if (!data || data.length === 0) {
    showStatus('err', '❌ Lokasi tidak ditemukan. Pastikan ini adalah alamat di Surabaya dan coba lagi.');
    return;
  }
  fillFromNominatim(data[0]);
}

function fillFromNominatim(data) {
  const addr = data.address || {};
  const displayName = data.display_name || '';

  // Cek apakah di Surabaya
  const city = (addr.city || addr.town || addr.municipality || addr.county || '').toLowerCase();
  const isSuby = city.includes('surabaya') || displayName.toLowerCase().includes('surabaya');
  if (!isSuby) {
    showStatus('err', '⚠️ Lokasi ini berada di luar Kota Surabaya. Layanan kami hanya tersedia di Surabaya.');
    return;
  }

  // Ambil komponen alamat
  const jalan = buildJalan(addr);
  const kelurahan = addr.suburb || addr.village || addr.neighbourhood || addr.quarter || '';
  const kecamatan = findKecamatan(addr, jalan, displayName);
  const patokan = addr.amenity || addr.shop || addr.building || addr.tourism || '';

  // Isi field
  let filled = [];

  if (jalan) {
    document.getElementById('jalan').value = jalan;
    filled.push('Nama Jalan');
  }

  if (kelurahan) {
    document.getElementById('kelurahan').value
      = capitalizeWords(kelurahan.replace(/kelurahan\s*/i,'').trim());
    filled.push('Kelurahan');
  }

  if (kecamatan) {
    const sel = document.getElementById('kecamatan');
    const opts = Array.from(sel.options);
    const match = opts.find(o => o.text.toLowerCase().includes(kecamatan.toLowerCase())
                                || kecamatan.toLowerCase().includes(o.text.toLowerCase()));
    if (match) { sel.value = match.value; filled.push('Kecamatan'); }
  }

  if (patokan) {
    document.getElementById('patokan').value = capitalizeWords(patokan);
    filled.push('Patokan');
  }

  if (filled.length === 0) {
    showStatus('err', '⚠️ Link berhasil dibaca tapi data alamat terlalu minim. Coba link yang lebih spesifik.');
    return;
  }

  showStatus('ok', `✅ Berhasil! Field terisi otomatis: ${filled.join(', ')}.`);
}

function buildJalan(addr) {
  const parts = [];
  if (addr.road) parts.push('Jl. ' + capitalizeWords(addr.road));
  else if (addr.pedestrian) parts.push('Jl. ' + capitalizeWords(addr.pedestrian));
  if (addr.house_number) parts.push('No. ' + addr.house_number);
  return parts.join(' ');
}

function findKecamatan(addr, jalan, displayName) {
  // 1. Dari field subdistrict Nominatim
  const sub = addr.suburb || addr.subdistrict || addr.city_district || '';
  if (sub) {
    const cleaned = sub.replace(/kecamatan\s*/i,'').trim().toLowerCase();
    for (const k of Object.keys(KECAMATAN_DATA)) {
      if (k.toLowerCase().includes(cleaned) || cleaned.includes(k.toLowerCase())) return k;
    }
  }

  // 2. Cari di displayName
  const dn = displayName.toLowerCase();
  for (const k of Object.keys(KECAMATAN_DATA)) {
    if (dn.includes(k.toLowerCase())) return k;
  }

  // 3. Cocokkan nama jalan
  const j = jalan.toLowerCase();
  for (const [key, kec] of Object.entries(JALAN_KECAMATAN)) {
    if (j.includes(key)) return kec;
  }

  return '';
}

function capitalizeWords(str) {
  return str.split(' ').map(w => w ? w[0].toUpperCase() + w.slice(1).toLowerCase() : '').join(' ');
}

function showStatus(type, msg) {
  const el = document.getElementById('gmaps-status');
  el.style.display = 'block';
  el.className = 'gmaps-status ' + type;
  el.textContent = msg;
}
